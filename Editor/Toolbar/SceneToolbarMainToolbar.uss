.scene-pin-settings-overlay .unity-toolbar-button.scene-pin-settings-button,
.scene-pin-scenes-overlay .unity-toolbar-button.scene-pin-scene-button {
    background-color: #505050;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.scene-pin-settings-overlay .unity-toolbar-button.scene-pin-settings-button:hover,
.scene-pin-scenes-overlay .unity-toolbar-button.scene-pin-scene-button:hover {
    background-color: #606060;
}

.scene-pin-settings-overlay .unity-toolbar-button.scene-pin-settings-button:active,
.scene-pin-scenes-overlay .unity-toolbar-button.scene-pin-scene-button:active {
    background-color: #414141;
}
