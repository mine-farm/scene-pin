:root {
    --scene-accent: #4f9cf9;
    --scene-accent-hover: #69adff;
    --scene-success: #60b86b;
    --scene-warning: #e2a553;
    --scene-danger: #d96c72;
    --scene-muted: rgba(160, 168, 178, 0.86);
    --scene-button-background: rgba(127, 127, 127, 0.16);
    --scene-button-background-hover: rgba(127, 127, 127, 0.28);
    --scene-button-background-active: rgba(127, 127, 127, 0.38);
    --scene-button-border: rgba(127, 127, 127, 0.45);
    --scene-button-border-hover: rgba(127, 127, 127, 0.62);
}

.scene-toolbar-root {
    flex-grow: 1;
    padding: 12px;
    background-color: var(--unity-colors-window-background);
}

.scene-toolbar-hero {
    flex-direction: row;
    align-items: center;
    padding: 14px 16px;
    margin-bottom: 8px;
    background-color: var(--unity-colors-box-background);
    border-left-width: 3px;
    border-left-color: var(--scene-accent);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.scene-toolbar-hero-copy {
    flex-grow: 1;
    min-width: 240px;
}

.scene-toolbar-title {
    -unity-font-style: bold;
    font-size: 18px;
    color: var(--unity-colors-default-text);
}

.scene-toolbar-subtitle {
    margin-top: 2px;
    color: var(--scene-muted);
}

.scene-toolbar-stats {
    flex-direction: row;
    align-items: center;
}

.scene-toolbar-stat {
    align-items: flex-end;
    min-width: 76px;
    margin-left: 16px;
}

.scene-toolbar-stat-value {
    -unity-font-style: bold;
    font-size: 16px;
    color: var(--scene-accent);
}

.scene-toolbar-stat-caption {
    font-size: 9px;
    color: var(--scene-muted);
}

.scene-toolbar-search-bar,
.scene-toolbar-panel-header,
.scene-toolbar-scene-row,
.scene-toolbar-name-line,
.scene-toolbar-row-actions,
.scene-toolbar-pinned-header,
.scene-toolbar-icon-row {
    flex-direction: row;
    align-items: center;
}

.scene-toolbar-search-bar {
    margin-bottom: 8px;
}

.scene-toolbar-search {
    flex-grow: 1;
    margin-right: 6px;
}

.scene-toolbar-organizer {
    padding: 8px;
    margin-bottom: 8px;
    background-color: var(--unity-colors-box-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.scene-toolbar-organizer-header,
.scene-toolbar-organizer-body,
.scene-toolbar-organizer-strip,
.scene-toolbar-organizer-chip {
    flex-direction: row;
    align-items: center;
}

.scene-toolbar-organizer-header {
    margin-bottom: 6px;
}

.scene-toolbar-organizer-title {
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
}

.scene-toolbar-organizer-description {
    margin-left: 8px;
    font-size: 9px;
    color: var(--scene-muted);
}

.scene-toolbar-organizer-body {
    min-height: 52px;
    align-items: stretch;
}

.scene-toolbar-organizer-scroll {
    flex-grow: 1;
    min-width: 0;
}

.scene-toolbar-organizer-strip {
    flex-grow: 1;
    min-height: 48px;
    padding: 5px;
    background-color: var(--unity-colors-default-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--scene-button-border);
    border-right-color: var(--scene-button-border);
    border-top-color: var(--scene-button-border);
    border-bottom-color: var(--scene-button-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.scene-toolbar-organizer-strip-active {
    background-color: rgba(79, 156, 249, 0.12);
    border-left-color: var(--scene-accent);
    border-right-color: var(--scene-accent);
    border-top-color: var(--scene-accent);
    border-bottom-color: var(--scene-accent);
}

.scene-toolbar-organizer-strip-active > .scene-toolbar-organizer-empty {
    display: none;
}

.scene-toolbar-organizer-empty {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: var(--scene-muted);
}

.scene-toolbar-organizer-chip {
    width: 126px;
    min-height: 36px;
    flex-shrink: 0;
    padding: 5px 6px;
    margin-right: 5px;
    background-color: var(--scene-button-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--scene-button-border);
    border-right-color: var(--scene-button-border);
    border-top-color: var(--scene-button-border);
    border-bottom-color: var(--scene-button-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.scene-toolbar-organizer-chip:hover {
    background-color: var(--scene-button-background-hover);
    border-left-color: var(--scene-button-border-hover);
    border-right-color: var(--scene-button-border-hover);
    border-top-color: var(--scene-button-border-hover);
    border-bottom-color: var(--scene-button-border-hover);
}

.scene-toolbar-organizer-position {
    min-width: 18px;
    margin-right: 4px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--scene-accent);
}

.scene-toolbar-organizer-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-right: 5px;
}

.scene-toolbar-organizer-name {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--unity-colors-default-text);
}

.scene-toolbar-drop-marker {
    width: 3px;
    min-height: 36px;
    flex-shrink: 0;
    margin-right: 4px;
    background-color: var(--scene-accent);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.scene-toolbar-unpin-drop-zone {
    min-width: 82px;
    margin-left: 6px;
    align-items: center;
    justify-content: center;
    background-color: rgba(217, 108, 114, 0.06);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(217, 108, 114, 0.45);
    border-right-color: rgba(217, 108, 114, 0.45);
    border-top-color: rgba(217, 108, 114, 0.45);
    border-bottom-color: rgba(217, 108, 114, 0.45);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.scene-toolbar-unpin-drop-zone-active {
    background-color: rgba(217, 108, 114, 0.22);
    border-left-color: var(--scene-danger);
    border-right-color: var(--scene-danger);
    border-top-color: var(--scene-danger);
    border-bottom-color: var(--scene-danger);
}

.scene-toolbar-unpin-drop-icon {
    width: 14px;
    height: 14px;
    margin-bottom: 2px;
}

.scene-toolbar-unpin-drop-label {
    font-size: 9px;
    color: var(--scene-danger);
}

.scene-toolbar-tab-view {
    flex-grow: 1;
    min-height: 320px;
}

.scene-toolbar-tab-bar {
    flex-direction: row;
    align-items: flex-end;
}

.scene-toolbar-tab-button {
    min-width: 140px;
    min-height: 30px;
    margin-right: 3px;
    margin-bottom: -1px;
    padding: 5px 14px;
    -unity-font-style: bold;
    color: var(--scene-muted);
    background-color: var(--scene-button-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 2px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: transparent;
    border-bottom-color: var(--unity-colors-default-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.scene-toolbar-tab-button:hover {
    color: var(--unity-colors-default-text);
    background-color: var(--scene-button-background-hover);
}

.scene-toolbar-tab-button-active,
.scene-toolbar-tab-button-active:hover {
    color: var(--unity-colors-default-text);
    background-color: var(--unity-colors-box-background);
    border-top-color: var(--scene-accent);
    border-bottom-color: var(--unity-colors-box-background);
}

.scene-toolbar-tab-content {
    flex-grow: 1;
    min-height: 0;
}

.scene-toolbar-tab-panel {
    display: none;
}

.scene-toolbar-tab-panel-active {
    display: flex;
}

.scene-toolbar-panel {
    flex-grow: 1;
    min-width: 250px;
    background-color: var(--unity-colors-box-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.scene-toolbar-panel-header {
    padding: 10px 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.scene-toolbar-panel-heading {
    flex-grow: 1;
}

.scene-toolbar-panel-title {
    -unity-font-style: bold;
    font-size: 13px;
    color: var(--unity-colors-default-text);
}

.scene-toolbar-panel-description {
    margin-top: 1px;
    font-size: 10px;
    color: var(--scene-muted);
}

.scene-toolbar-count-badge {
    min-width: 28px;
    padding: 3px 7px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--unity-colors-button-text);
    background-color: var(--unity-colors-button-background);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.scene-toolbar-scroll {
    flex-grow: 1;
    padding: 6px;
}

.scene-toolbar-results {
    flex-grow: 1;
}

.scene-toolbar-scene-row {
    min-height: 50px;
    padding: 7px 8px;
    margin-bottom: 4px;
    background-color: var(--unity-colors-default-background);
    border-left-width: 2px;
    border-left-color: transparent;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.scene-toolbar-scene-row:hover {
    background-color: var(--unity-colors-highlight-background-hover-lighter);
}

.scene-toolbar-scene-row-active {
    border-left-color: var(--scene-success);
}

.scene-toolbar-scene-icon {
    width: 26px;
    height: 26px;
    margin-right: 8px;
}

.scene-toolbar-scene-drag-source {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.scene-toolbar-scene-drag-source:hover {
    background-color: var(--scene-button-background-hover);
}

.scene-toolbar-scene-information,
.scene-toolbar-pinned-information {
    flex-grow: 1;
    min-width: 80px;
}

.scene-toolbar-scene-name,
.scene-toolbar-pinned-name {
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.scene-toolbar-scene-path {
    margin-top: 2px;
    font-size: 9px;
    color: var(--scene-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.scene-toolbar-badge {
    padding: 1px 5px;
    margin-left: 5px;
    font-size: 8px;
    -unity-font-style: bold;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.scene-toolbar-badge-active {
    color: #dff8e2;
    background-color: rgba(66, 145, 76, 0.78);
}

.scene-toolbar-badge-pinned {
    color: #e4efff;
    background-color: rgba(52, 104, 172, 0.82);
}

.scene-toolbar-badge-build {
    color: #fff0d4;
    background-color: rgba(163, 111, 45, 0.82);
}

.scene-toolbar-row-actions {
    flex-shrink: 0;
    margin-left: 8px;
}

.scene-toolbar-small-button,
.scene-toolbar-icon-button,
.scene-toolbar-secondary-button {
    min-height: 22px;
    margin-left: 3px;
    align-items: center;
    justify-content: center;
    background-color: var(--scene-button-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--scene-button-border);
    border-right-color: var(--scene-button-border);
    border-top-color: var(--scene-button-border);
    border-bottom-color: var(--scene-button-border);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.scene-toolbar-small-button:hover,
.scene-toolbar-icon-button:hover,
.scene-toolbar-secondary-button:hover {
    background-color: var(--scene-button-background-hover);
    border-left-color: var(--scene-button-border-hover);
    border-right-color: var(--scene-button-border-hover);
    border-top-color: var(--scene-button-border-hover);
    border-bottom-color: var(--scene-button-border-hover);
}

.scene-toolbar-small-button:active,
.scene-toolbar-icon-button:active,
.scene-toolbar-secondary-button:active {
    background-color: var(--scene-button-background-active);
}

.scene-toolbar-small-button:disabled,
.scene-toolbar-icon-button:disabled,
.scene-toolbar-secondary-button:disabled {
    background-color: rgba(127, 127, 127, 0.08);
    border-left-color: rgba(127, 127, 127, 0.2);
    border-right-color: rgba(127, 127, 127, 0.2);
    border-top-color: rgba(127, 127, 127, 0.2);
    border-bottom-color: rgba(127, 127, 127, 0.2);
}

.scene-toolbar-small-button {
    width: 30px;
    min-width: 30px;
    padding-left: 5px;
    padding-right: 5px;
}

.scene-toolbar-icon-button {
    width: 28px;
    min-width: 28px;
    padding-left: 5px;
    padding-right: 5px;
}

.scene-toolbar-secondary-button {
    width: 30px;
    min-width: 30px;
    padding-left: 5px;
    padding-right: 5px;
}

.scene-toolbar-button-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
}

.scene-toolbar-small-button:disabled > .scene-toolbar-button-icon,
.scene-toolbar-icon-button:disabled > .scene-toolbar-button-icon,
.scene-toolbar-secondary-button:disabled > .scene-toolbar-button-icon {
    opacity: 0.35;
}

.scene-toolbar-pin-button {
    color: white;
    background-color: var(--scene-accent);
    border-left-color: var(--scene-accent);
    border-right-color: var(--scene-accent);
    border-top-color: var(--scene-accent);
    border-bottom-color: var(--scene-accent);
}

.scene-toolbar-pin-button:hover {
    background-color: var(--scene-accent-hover);
}

.scene-toolbar-pin-button:active {
    background-color: #3f82d1;
}

.scene-toolbar-unpin-button {
    color: var(--scene-danger);
}

.scene-toolbar-pinned-card {
    padding: 8px;
    margin-bottom: 6px;
    background-color: var(--unity-colors-default-background);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--unity-colors-default-border);
    border-right-color: var(--unity-colors-default-border);
    border-top-color: var(--unity-colors-default-border);
    border-bottom-color: var(--unity-colors-default-border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.scene-toolbar-pinned-header {
    min-height: 34px;
}

.scene-toolbar-position {
    min-width: 22px;
    min-height: 22px;
    margin-right: 6px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--scene-accent);
    background-color: var(--unity-colors-button-background);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}

.scene-toolbar-pinned-icon {
    width: 22px;
    height: 22px;
    margin-right: 7px;
}

.scene-toolbar-appearance {
    margin-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
}

.scene-toolbar-field {
    margin-top: 3px;
}

.scene-toolbar-field > .unity-base-field__label {
    min-width: 96px;
}

.scene-toolbar-icon-row {
    margin-top: 3px;
}

.scene-toolbar-grow {
    flex-grow: 1;
}

.scene-toolbar-icon-preview {
    width: 24px;
    height: 24px;
    margin-left: 6px;
    margin-right: 6px;
}

.scene-toolbar-empty,
.scene-toolbar-empty-card,
.scene-toolbar-warning,
.scene-toolbar-footer {
    white-space: normal;
}

.scene-toolbar-empty-card {
    padding: 18px 14px;
    margin: 6px;
    -unity-text-align: middle-center;
    color: var(--scene-muted);
    background-color: var(--unity-colors-default-background);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.scene-toolbar-empty-title {
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
}

.scene-toolbar-empty-copy {
    margin-top: 4px;
    white-space: normal;
}

.scene-toolbar-warning {
    color: var(--scene-warning);
}

.scene-toolbar-valid {
    color: var(--scene-success);
}

.scene-toolbar-footer {
    margin-top: 7px;
    font-size: 9px;
    color: var(--scene-muted);
}
